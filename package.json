{
  "name": "autotestoneui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "docs:manifest": "node scripts/generate-docs-manifest.mjs",
    "docs:vendor": "node scripts/copy-mermaid-vendor.mjs",
    "predev": "npm run docs:manifest && npm run docs:vendor",
    "prebuild": "npm run docs:manifest && npm run docs:vendor",
    "srs:screenshots": "node scripts/srs-screenshots/capture.mjs"
  },
  "dependencies": {
    "antd": "^6.3.3",
    "github-slugger": "^2.0.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.52.0",
    "@types/github-slugger": "^1.3.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
